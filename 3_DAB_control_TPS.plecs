            Value         "1"
            Show          off
          }
          Parameter {
            Variable      "Ts"
            Value         "Ts_control"
            Show          off
          }
          Parameter {
            Variable      "Parameters"
            Value         "Ts_control, fsw, L12, N, Vdc1"
            Show          off
          }
          Parameter {
            Variable      "LangStandard"
            Value         "2"
            Show          off
          }
          Parameter {
            Variable      "GnuExtensions"
            Value         "1"
            Show          off
          }
          Parameter {
            Variable      "RuntimeCheck"
            Value         "2"
            Show          off
          }
          Parameter {
            Variable      "Declarations"
            Value         "#include <float.h>\n"
"#include <stdio.h>\n"
"#include <math.h>\n"
"\n"
"// AGREGAR TABLA \n"
"#include \"DAB_210_130a200_2p5kw_zvs_1.c\" \n"
"\n"
"// CONSTANT DECLARATION\n"
"// Input\n"
"#define Ts  \tParamRealData(0,0)\n"
"#define fsw  \tParamRealData(1,0)\n"
"#define L12  \tParamRealData(2,0)\n"
"#define N   \tParamRealData(3,0)\n"
"#define Vdc1_fijo  \tParamRealData(4,0)\n"
"\n"
"// Constant\n"
"#define PI    3.14159265\n"
"\n"
"\n"
"float Vdc1_buscar, Vdc2_buscar, P2_buscar ; \n"
"float Vdc1_med, Vdc2_med, Pdc2_ref ;   \n"
"int u_index, jVdc2, jP2 ; \n"
"float D1opt, D2opt, X12opt ; \n"
"\n"
"\n"
"\n"
"\n"
"float saturacion_normal(float valor, float lim_inf, float lim_sup) \n"
"{  \n"
"// float valor, lim_sup, lim_inf ;\n"
"   if (valor>lim_sup) \n"
"   {  valor = lim_sup ; }\n"
"   else if (valor<lim_inf) \n"
"   {  valor = lim_inf ; }\n"
"   return valor ; \n"
"}\n"
"\n"
"float absnum(float numero)\n"
"{\n"
"   if (numero < 0.0)\n"
"   {\n"
"      numero = numero * (-1.0) ; \n"
"   }\n"
"   return numero ;\n"
"}"
            Show          off
          }
          Parameter {
            Variable      "StartFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "OutputFcn"
            Value         "// MEDICIONES\n"
"Vdc1_med    = InputSignal(0,0);\n"
"Vdc2_med    = InputSignal(0,1);\n"
"Pdc2_ref    = InputSignal(0,2);\n"
"\n"
"\n"
"// CALCULO HASH \n"
"// Validaciones\n"
"Vdc1_buscar = saturacion_normal(Vdc1_med,Vdc1_fijo,Vdc1_fijo) ; \n"
"Vdc2_buscar = saturacion_normal(Vdc2_med,Vdc2min_tabla,Vdc2max_tabla) ; \n"
"P2_buscar = saturacion_normal( absnum(Pdc2_ref) ,P2min_tabla,P2max_tabla) ; "
"\n"
"// Indices parciales\n"
"jVdc2 = round( (Vdc2_buscar - Vdc2min_tabla)/pasoVdc2_tabla ) ; \n"
"jP2   = round( (P2_buscar - P2min_tabla)/pasoP2_tabla ) ;  \n"
"// Indice Hash \n"
"u_index = 3*( jVdc2*dimP2_tabla + jP2 ) ; \n"
"\n"
"\n"
"// SELECCION DE VALORES OPTIMOS \n"
"D1opt  = DATADAB[u_index + 0] ; \n"
"D2opt  = DATADAB[u_index + 1] ; \n"
"X12opt = DATADAB[u_index + 2] ; \n"
"\n"
"if (Pdc2_ref<0){\n"
"\tX12opt = (-1)*X12opt ; \n"
"} \n"
"\n"
"\n"
"// SALIDA\n"
"OutputSignal(0,0) = D1opt ; \n"
"OutputSignal(0,1) = D2opt ; \n"
"OutputSignal(0,2) = X12opt ;\n"
"\n"
"OutputSignal(1,0) = jVdc2 ; \n"
"OutputSignal(1,1) = jP2 ; \n"
"OutputSignal(1,2) = u_index ; \n"
            Show          off
          }
          Parameter {
            Variable      "UpdateFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "DerivativeFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "TerminateFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "StoreCustomStateFcn"
            Value         ""
            Show          off
          }
