        Component {
          Type          CScript
          Name          "TPS_OPT_SELECT"
          Show          on
          Position      [490, 495]
          Direction     up
          Flipped       off
          LabelPosition south
          Parameter {
            Variable      "DialogGeometry"
            Value         "[408 244 766 658]"
            Show          off
