  AssertionAction "1"
  InitializationCommands "%% GENERAL \nTs = 1e-6 ;\t\t% Tiempo muestreo maestr"
"o\nfsw = 50e3 ;   % switching frequency (Hz)\nTs_control = 5/fsw ; \n\n%% DC "
"PORTS \n% Voltajes nominales \nVdc1 = 210 ;  % dc port 1 (V)\nVdc2 = 173 ;  %"
" dc port 2 (V)\n% Voltajes de equipo fijo \nVdc1_fijo = Vdc1 ; % Vdc equipo f"
"ijo  \nVdc2_fijo = Vdc2 ; % Vdc equipo fijo \n% Filtros \nIdc1_filter_init = "
"0 ; \nVdc1_filter_init = Vdc1 ; \nIdc2_filter_init = 0 ; \nVdc2_filter_init ="
" Vdc2 ; \n\n\n%% AC PORTS \nn1 = 9 ;  % n1/n2 = v1/v2\nn2 = 4 ;  % v2 = v1*n2"
"/n1 \nN = n1/n2 ; \n\n%\nL1   = 36.733e-6 ; \nR_L1 = 10e-3 ; \nL2   = 0*20e-6"
" ; \nR_L2 = 0*3*10e-3 ; \n%\nL12 = L1 + L2*(n1/n2)*(n1/n2) ; \nPmax = (n1/n2)"
"*Vdc1*Vdc2*0.25 / ( 2*fsw*L12 ) ; \n\nX = (N*Vdc1*Vdc2)/( 2*fsw*L12*pi*pi ) ;"
" \n\n\n%% CARGA \nR_carga = 5*1 ; \nCo = 4.1*100e-6 ; \n\n\n%% DEADTIME \ndea"
"dtime = ( 200e-9 ) *1  ; % 500 ns\n\n\n%% MODELO TERMICO SEMICONDUCTOORES\nT_"
"inicial = 25 ; \nT_ambiente = 25 ; \n%\nR_gate_ext = 8 ; \nR_cs = 0 ; \n%\nR_"
"thermal_pad = 0.2 ; \nC_thermal_pad = 0.001 ; \n%\nR_heatsink = 0.6 ; \nC_hea"
"tsink = 0.01 ; "
