                ZoomFactor    1.14437
                SliderPosition [0, 0]
                ShowBrowser   off
                BrowserWidth  100
                Component {
                  Type          CScript
                  Name          "PI_code_full"
                  Show          on
                  Position      [220, 60]
                  Direction     up
                  Flipped       off
                  LabelPosition north
                  Parameter {
                    Variable      "DialogGeometry"
                    Value         "[113 224 1291 663]"
                    Show          off
                  }
                  Parameter {
                    Variable      "NumInputs"
                    Value         "9"
